apiVersion: v1
kind: ConfigMap
metadata:
  name: directus-backup-config
  namespace: directus
  labels:
    app.kubernetes.io/name: directus-full-backup
    app.kubernetes.io/managed-by: terraform-output-reconciler
data:
  GCS_BUCKET: "__GCS_BUCKET__"
  GCS_PREFIX: "directus-production"
  RETENTION_COUNT: "2"
  VERIFY_RESTORE: "true"
  SSH_USER: "ubuntu"
  SSH_REMOTE_DB_HOST: "127.0.0.1"
  SSH_REMOTE_DB_PORT: "5432"
  SSH_LOCAL_DB_PORT: "15432"
  UPLOADS_PATH: "/source-uploads"
  VERIFY_DB_HOST: "127.0.0.1"
  VERIFY_DB_PORT: "55432"
  VERIFY_DB_NAME: "directus_restore_verify"
  BACKUP_WORK_DIR: "/work"
  CONNECT_TIMEOUT_SECONDS: "10"
  COMMAND_TIMEOUT_SECONDS: "7200"
  RESTORE_TIMEOUT_SECONDS: "7200"
