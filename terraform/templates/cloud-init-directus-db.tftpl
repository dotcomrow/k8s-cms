#cloud-config
package_update: true
package_upgrade: false
packages:
  - postgresql
  - postgresql-contrib
  - nfs-kernel-server
  - rpcbind
  - logrotate

write_files:
  - path: /usr/local/sbin/bootstrap-directus-postgres.sh
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      DB_NAME=$(cat <<'EOF_DB_NAME'
      ${db_name}
      EOF_DB_NAME
      )
      DB_USER=$(cat <<'EOF_DB_USER'
      ${directus_db_user}
      EOF_DB_USER
      )
      DB_PASS=$(cat <<'EOF_DB_PASS'
      ${directus_db_password}
      EOF_DB_PASS
      )
      ENABLE_DB_SSH_TUNNEL=$(cat <<'EOF_ENABLE_DB_SSH_TUNNEL'
      ${enable_db_ssh_tunnel}
      EOF_ENABLE_DB_SSH_TUNNEL
      )
      DB_TUNNEL_USER=$(cat <<'EOF_DB_TUNNEL_USER'
      ${db_tunnel_user}
      EOF_DB_TUNNEL_USER
      )
      DB_TUNNEL_PUBLIC_KEY=$(cat <<'EOF_DB_TUNNEL_PUBLIC_KEY'
      ${db_tunnel_public_key}
      EOF_DB_TUNNEL_PUBLIC_KEY
      )
      ENABLE_DIRECTUS_UPLOADS_NFS=$(cat <<'EOF_ENABLE_DIRECTUS_UPLOADS_NFS'
      ${enable_directus_uploads_nfs}
      EOF_ENABLE_DIRECTUS_UPLOADS_NFS
      )
      DIRECTUS_UPLOADS_EXPORT_PATH=$(cat <<'EOF_DIRECTUS_UPLOADS_EXPORT_PATH'
      ${directus_uploads_export_path}
      EOF_DIRECTUS_UPLOADS_EXPORT_PATH
      )
      DIRECTUS_UPLOADS_NFS_ANON_UID=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_ANON_UID'
      ${directus_uploads_nfs_anon_uid}
      EOF_DIRECTUS_UPLOADS_NFS_ANON_UID
      )
      DIRECTUS_UPLOADS_NFS_ANON_GID=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_ANON_GID'
      ${directus_uploads_nfs_anon_gid}
      EOF_DIRECTUS_UPLOADS_NFS_ANON_GID
      )
      DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT'
      ${directus_uploads_nfs_enable_v3_compat}
      EOF_DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT
      )
      DIRECTUS_UPLOADS_NFS_RPCBIND_PORT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_RPCBIND_PORT'
      ${directus_uploads_nfs_rpcbind_port}
      EOF_DIRECTUS_UPLOADS_NFS_RPCBIND_PORT
      )
      DIRECTUS_UPLOADS_NFS_MOUNTD_PORT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_MOUNTD_PORT'
      ${directus_uploads_nfs_mountd_port}
      EOF_DIRECTUS_UPLOADS_NFS_MOUNTD_PORT
      )

      DB_NAME="$(printf '%s' "$${DB_NAME}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      DB_USER="$(printf '%s' "$${DB_USER}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      DB_PASS="$(printf '%s' "$${DB_PASS}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      ENABLE_DB_SSH_TUNNEL="$(printf '%s' "$${ENABLE_DB_SSH_TUNNEL}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
      DB_TUNNEL_USER="$(printf '%s' "$${DB_TUNNEL_USER}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      DB_TUNNEL_PUBLIC_KEY="$(printf '%s' "$${DB_TUNNEL_PUBLIC_KEY}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      ENABLE_DIRECTUS_UPLOADS_NFS="$(printf '%s' "$${ENABLE_DIRECTUS_UPLOADS_NFS}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
      DIRECTUS_UPLOADS_EXPORT_PATH="$(printf '%s' "$${DIRECTUS_UPLOADS_EXPORT_PATH}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      DIRECTUS_UPLOADS_NFS_ANON_UID="$(printf '%s' "$${DIRECTUS_UPLOADS_NFS_ANON_UID}" | tr -dc '0-9')"
      DIRECTUS_UPLOADS_NFS_ANON_GID="$(printf '%s' "$${DIRECTUS_UPLOADS_NFS_ANON_GID}" | tr -dc '0-9')"
      DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT="$(printf '%s' "$${DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
      DIRECTUS_UPLOADS_NFS_RPCBIND_PORT="$(printf '%s' "$${DIRECTUS_UPLOADS_NFS_RPCBIND_PORT}" | tr -dc '0-9')"
      DIRECTUS_UPLOADS_NFS_MOUNTD_PORT="$(printf '%s' "$${DIRECTUS_UPLOADS_NFS_MOUNTD_PORT}" | tr -dc '0-9')"

      if [ -z "$DB_NAME" ] || [ -z "$DB_USER" ] || [ -z "$DB_PASS" ]; then
        echo "Directus DB bootstrap values are missing."
        exit 1
      fi

      if [ "$ENABLE_DB_SSH_TUNNEL" = "true" ]; then
        if [ -z "$DB_TUNNEL_PUBLIC_KEY" ]; then
          echo "DB tunnel enabled but public key is missing."
          exit 1
        fi

        id -u "$DB_TUNNEL_USER" >/dev/null 2>&1 || useradd --create-home --shell /bin/bash "$DB_TUNNEL_USER"

        # Ubuntu often creates local users with a locked password ("L"), which
        # can block pubkey SSH auth. Set a random local password hash so the
        # account is considered unlocked while still requiring pubkey auth.
        tunnel_pass_state="$(passwd -S "$DB_TUNNEL_USER" 2>/dev/null | awk '{print $2}' || true)"
        if [ "$tunnel_pass_state" = "L" ] || [ "$tunnel_pass_state" = "NP" ] || [ -z "$tunnel_pass_state" ]; then
          if command -v openssl >/dev/null 2>&1; then
            random_tunnel_password="$(openssl rand -base64 48 | tr -d '\n' | cut -c1-48)"
          else
            random_tunnel_password="$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | base64 | tr -d '\n' | cut -c1-48)"
          fi
          printf '%s:%s\n' "$DB_TUNNEL_USER" "$random_tunnel_password" | chpasswd
        fi
        chage -I -1 -m 0 -M 99999 -E -1 "$DB_TUNNEL_USER" >/dev/null 2>&1 || true

        install -d -m 700 -o "$DB_TUNNEL_USER" -g "$DB_TUNNEL_USER" "/home/$DB_TUNNEL_USER/.ssh"
        printf '%s\n' "$DB_TUNNEL_PUBLIC_KEY" > "/home/$DB_TUNNEL_USER/.ssh/authorized_keys"
        chown "$DB_TUNNEL_USER:$DB_TUNNEL_USER" "/home/$DB_TUNNEL_USER/.ssh/authorized_keys"
        chmod 600 "/home/$DB_TUNNEL_USER/.ssh/authorized_keys"

        install -d -m 755 /etc/ssh/sshd_config.d
        cat > /etc/ssh/sshd_config.d/90-directus-db-tunnel.conf <<EOF_SSHD
      Match User $DB_TUNNEL_USER
        PasswordAuthentication no
        KbdInteractiveAuthentication no
        PubkeyAuthentication yes
        AuthenticationMethods publickey
        AllowTcpForwarding yes
        X11Forwarding no
        PermitTTY no
      EOF_SSHD

        systemctl reload ssh >/dev/null 2>&1 || systemctl reload sshd >/dev/null 2>&1 || true
      fi

      if [ "$ENABLE_DIRECTUS_UPLOADS_NFS" = "true" ]; then
        if [ -z "$DIRECTUS_UPLOADS_EXPORT_PATH" ]; then
          echo "Directus uploads NFS export path is missing."
          exit 1
        fi
        if [ -z "$DIRECTUS_UPLOADS_NFS_ANON_UID" ]; then
          DIRECTUS_UPLOADS_NFS_ANON_UID="1000"
        fi
        if [ -z "$DIRECTUS_UPLOADS_NFS_ANON_GID" ]; then
          DIRECTUS_UPLOADS_NFS_ANON_GID="1000"
        fi
        if [ -z "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" ]; then
          DIRECTUS_UPLOADS_NFS_RPCBIND_PORT="111"
        fi
        if [ -z "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" ]; then
          DIRECTUS_UPLOADS_NFS_MOUNTD_PORT="20048"
        fi
        if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" != "true" ]; then
          DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT="false"
        fi

        install -d -m 0775 "$DIRECTUS_UPLOADS_EXPORT_PATH"
        chown "$DIRECTUS_UPLOADS_NFS_ANON_UID:$DIRECTUS_UPLOADS_NFS_ANON_GID" "$DIRECTUS_UPLOADS_EXPORT_PATH"
        install -d -m 0755 /etc/directus
        cat > /etc/directus/directus-uploads-nfs-allowed-cidrs.txt <<'EOF_DIRECTUS_NFS_ALLOWED_CIDRS'
      ${directus_uploads_nfs_allowed_cidrs}
      EOF_DIRECTUS_NFS_ALLOWED_CIDRS
        sed -i '/^[[:space:]]*$/d' /etc/directus/directus-uploads-nfs-allowed-cidrs.txt

        # Pin NFS daemon behavior so OCI firewall rules and server ports stay predictable.
        if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" = "true" ]; then
          NFS_V3_ENABLED="y"
        else
          NFS_V3_ENABLED="n"
        fi
        install -d -m 0755 /etc/nfs.conf.d
        cat > /etc/nfs.conf.d/90-directus-uploads.conf <<EOF_DIRECTUS_NFS_CONF
      [nfsd]
      vers3=$NFS_V3_ENABLED
      vers4=y
      vers4.1=y
      vers4.2=y
      tcp=y
      udp=y
      port=2049

      [mountd]
      port=$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT
      EOF_DIRECTUS_NFS_CONF
        if grep -Eq '^RPCMOUNTDOPTS=' /etc/default/nfs-kernel-server; then
          sed -ri "s|^RPCMOUNTDOPTS=.*|RPCMOUNTDOPTS=\"--port $DIRECTUS_UPLOADS_NFS_MOUNTD_PORT\"|" /etc/default/nfs-kernel-server
        else
          printf '\nRPCMOUNTDOPTS=\"--port %s\"\n' "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" >> /etc/default/nfs-kernel-server
        fi
        if grep -Eq '^OPTIONS=' /etc/default/rpcbind; then
          sed -ri "s|^OPTIONS=.*|OPTIONS=\"-w\"|" /etc/default/rpcbind
        else
          printf '\nOPTIONS=\"-w\"\n' >> /etc/default/rpcbind
        fi

        install -d -m 0755 /etc/exports.d
        cat > /etc/exports.d/directus-uploads.exports <<'EOF_DIRECTUS_NFS_EXPORTS'
      ${directus_uploads_nfs_exports}
      EOF_DIRECTUS_NFS_EXPORTS
        sed -i "s/anonuid=[0-9][0-9]*/anonuid=$DIRECTUS_UPLOADS_NFS_ANON_UID/g; s/anongid=[0-9][0-9]*/anongid=$DIRECTUS_UPLOADS_NFS_ANON_GID/g" /etc/exports.d/directus-uploads.exports

        # Some OCI Ubuntu images enforce host iptables with final REJECT.
        # Insert explicit NFS allow rules before that REJECT so kubelet can mount.
        if command -v iptables >/dev/null 2>&1; then
          _ensure_input_accept_rule() {
            _proto="$1"
            _port="$2"
            _cidr="$3"
            if iptables -C INPUT -p "$_proto" -s "$_cidr" --dport "$_port" -j ACCEPT >/dev/null 2>&1; then
              return 0
            fi
            _reject_line="$(iptables -L INPUT --line-numbers | awk '$2 == "REJECT" {print $1; exit}')"
            if [ -n "$_reject_line" ]; then
              iptables -I INPUT "$_reject_line" -p "$_proto" -s "$_cidr" --dport "$_port" -j ACCEPT
            else
              iptables -A INPUT -p "$_proto" -s "$_cidr" --dport "$_port" -j ACCEPT
            fi
          }

          _persist_iptables_rules() {
            if ! command -v iptables-save >/dev/null 2>&1; then
              return 0
            fi
            install -d -m 0755 /etc/iptables
            rules_v4_path="/etc/iptables/rules.v4"
            iptables-save > "$rules_v4_path"
            if command -v ip6tables-save >/dev/null 2>&1; then
              ip6tables-save > /etc/iptables/rules.v6 || true
            fi
            if [ -f /lib/systemd/system/netfilter-persistent.service ] || [ -f /usr/lib/systemd/system/netfilter-persistent.service ]; then
              systemctl enable netfilter-persistent >/dev/null 2>&1 || true
            fi
          }

          while IFS= read -r _cidr; do
            _cidr="$(printf '%s' "$_cidr" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            [ -z "$_cidr" ] && continue
            _ensure_input_accept_rule tcp 2049 "$_cidr"
            _ensure_input_accept_rule udp 2049 "$_cidr"
            if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" = "true" ]; then
              _ensure_input_accept_rule tcp "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" "$_cidr"
              _ensure_input_accept_rule udp "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" "$_cidr"
              _ensure_input_accept_rule tcp "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" "$_cidr"
              _ensure_input_accept_rule udp "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" "$_cidr"
            fi
          done < /etc/directus/directus-uploads-nfs-allowed-cidrs.txt
          _persist_iptables_rules
        fi

        systemctl enable rpcbind >/dev/null 2>&1 || true
        systemctl restart rpcbind || true
        systemctl enable nfs-kernel-server >/dev/null 2>&1 || true
        systemctl restart nfs-kernel-server
        exportfs -ra

        # Fail bootstrap early if NFS did not become ready.
        if ! timeout 30 bash -c 'until ss -lnt | awk "{print \$4}" | grep -Eq "[:.]2049$"; do sleep 1; done'; then
          echo "NFS service did not open TCP 2049."
          exit 1
        fi
        if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" = "true" ]; then
          if ! timeout 30 bash -c "until ss -lnt | awk '{print \\$4}' | grep -Eq '[:.]$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT$'; do sleep 1; done"; then
            echo "rpcbind did not open TCP $DIRECTUS_UPLOADS_NFS_RPCBIND_PORT."
            exit 1
          fi
          if ! timeout 30 bash -c "until ss -lnt | awk '{print \\$4}' | grep -Eq '[:.]$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT$'; do sleep 1; done"; then
            echo "NFS mountd did not open TCP $DIRECTUS_UPLOADS_NFS_MOUNTD_PORT."
            exit 1
          fi
        fi
        if ! exportfs -v | grep -Fq "$DIRECTUS_UPLOADS_EXPORT_PATH"; then
          echo "NFS export path not active: $DIRECTUS_UPLOADS_EXPORT_PATH"
          exit 1
        fi
      fi

      pg_major="$(psql --version | awk '{print $3}' | cut -d. -f1)"
      pg_conf_dir="/etc/postgresql/$pg_major/main"
      pg_conf="$pg_conf_dir/postgresql.conf"
      pg_hba="$pg_conf_dir/pg_hba.conf"

      sed -ri "s|^#?listen_addresses\s*=.*|listen_addresses = '${postgres_listen_addresses}'|" "$pg_conf"
      sed -ri "s|^#?password_encryption\s*=.*|password_encryption = 'scram-sha-256'|" "$pg_conf"

      cat > /tmp/directus-pg-hba-rules.txt <<'EOF_PG_HBA'
      ${pg_hba_rules}
      EOF_PG_HBA

      while IFS= read -r raw_rule; do
        rule="$(printf '%s' "$raw_rule" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -z "$rule" ] && continue
        if ! grep -Fqx "$rule" "$pg_hba"; then
          echo "$rule" >> "$pg_hba"
        fi
      done < /tmp/directus-pg-hba-rules.txt
      rm -f /tmp/directus-pg-hba-rules.txt

      systemctl enable postgresql
      systemctl restart postgresql

      sudo -u postgres psql \
        -v ON_ERROR_STOP=1 \
        -v directus_db_name="$DB_NAME" \
        -v directus_db_user="$DB_USER" \
        -v directus_db_password="$DB_PASS" \
        <<'SQL'
      DO $do$
      DECLARE
        v_db_name text := :'directus_db_name';
        v_db_user text := :'directus_db_user';
        v_db_password text := :'directus_db_password';
      BEGIN
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = v_db_user) THEN
          EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L', v_db_user, v_db_password);
        ELSE
          EXECUTE format('ALTER ROLE %I WITH LOGIN PASSWORD %L', v_db_user, v_db_password);
        END IF;

        IF NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = v_db_name) THEN
          EXECUTE format('CREATE DATABASE %I OWNER %I', v_db_name, v_db_user);
        END IF;

        EXECUTE format('GRANT CONNECT ON DATABASE %I TO %I', v_db_name, v_db_user);
      END
      $do$;
      SQL

      sudo -u postgres psql \
        -v ON_ERROR_STOP=1 \
        -d "$DB_NAME" \
        -v directus_db_user="$DB_USER" \
        <<'SQL'
      DO $do$
      DECLARE
        v_db_user text := :'directus_db_user';
      BEGIN
        EXECUTE format('CREATE SCHEMA IF NOT EXISTS directus AUTHORIZATION %I', v_db_user);
        EXECUTE format('ALTER ROLE %I SET search_path = directus, public', v_db_user);
        EXECUTE format('GRANT USAGE, CREATE ON SCHEMA directus TO %I', v_db_user);
        EXECUTE format('GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA directus TO %I', v_db_user);
        EXECUTE format('GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA directus TO %I', v_db_user);
        EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA directus GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO %I', v_db_user);
        EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA directus GRANT USAGE, SELECT ON SEQUENCES TO %I', v_db_user);
      END
      $do$;
      SQL

      echo "Directus PostgreSQL bootstrap complete."

  - path: /usr/local/sbin/directus-db-guardian.sh
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -u -o pipefail

      ENABLE_DIRECTUS_UPLOADS_NFS=$(cat <<'EOF_ENABLE_DIRECTUS_UPLOADS_NFS'
      ${enable_directus_uploads_nfs}
      EOF_ENABLE_DIRECTUS_UPLOADS_NFS
      )
      DIRECTUS_UPLOADS_EXPORT_PATH=$(cat <<'EOF_DIRECTUS_UPLOADS_EXPORT_PATH'
      ${directus_uploads_export_path}
      EOF_DIRECTUS_UPLOADS_EXPORT_PATH
      )
      DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT'
      ${directus_uploads_nfs_enable_v3_compat}
      EOF_DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT
      )
      DIRECTUS_UPLOADS_NFS_RPCBIND_PORT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_RPCBIND_PORT'
      ${directus_uploads_nfs_rpcbind_port}
      EOF_DIRECTUS_UPLOADS_NFS_RPCBIND_PORT
      )
      DIRECTUS_UPLOADS_NFS_MOUNTD_PORT=$(cat <<'EOF_DIRECTUS_UPLOADS_NFS_MOUNTD_PORT'
      ${directus_uploads_nfs_mountd_port}
      EOF_DIRECTUS_UPLOADS_NFS_MOUNTD_PORT
      )

      ENABLE_DIRECTUS_UPLOADS_NFS="$(printf '%s' "$ENABLE_DIRECTUS_UPLOADS_NFS" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
      DIRECTUS_UPLOADS_EXPORT_PATH="$(printf '%s' "$DIRECTUS_UPLOADS_EXPORT_PATH" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT="$(printf '%s' "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
      DIRECTUS_UPLOADS_NFS_RPCBIND_PORT="$(printf '%s' "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" | tr -dc '0-9')"
      DIRECTUS_UPLOADS_NFS_MOUNTD_PORT="$(printf '%s' "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" | tr -dc '0-9')"

      if [ -z "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" ]; then
        DIRECTUS_UPLOADS_NFS_RPCBIND_PORT="111"
      fi
      if [ -z "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" ]; then
        DIRECTUS_UPLOADS_NFS_MOUNTD_PORT="20048"
      fi
      if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" != "true" ]; then
        DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT="false"
      fi

      NFS_ALLOWED_CIDRS_FILE="/etc/directus/directus-uploads-nfs-allowed-cidrs.txt"
      GUARDIAN_LOG="/var/log/directus-db-guardian.log"
      LOW_WATERMARK_PCT="80"
      HIGH_WATERMARK_PCT="90"
      JOURNAL_VACUUM_SIZE="300M"
      JOURNAL_VACUUM_TIME="14d"
      failures=0

      log_msg() {
        level="$1"
        shift
        message="$*"
        logger -t directus-db-guardian "[$level] $message" || true
        printf '%s [%s] %s\n' "$(date -Is)" "$level" "$message" >> "$GUARDIAN_LOG"
      }

      mark_failure() {
        failures="$((failures + 1))"
      }

      ensure_service_active() {
        svc="$1"
        if systemctl is-active --quiet "$svc"; then
          return 0
        fi
        log_msg warn "service_inactive $svc restarting"
        if ! systemctl restart "$svc"; then
          log_msg error "service_restart_failed $svc"
          mark_failure
          return 1
        fi
        if ! systemctl is-active --quiet "$svc"; then
          log_msg error "service_not_active_after_restart $svc"
          mark_failure
          return 1
        fi
        log_msg info "service_recovered $svc"
      }

      ensure_nfs_firewall_rules() {
        if [ "$ENABLE_DIRECTUS_UPLOADS_NFS" != "true" ]; then
          return 0
        fi
        if ! command -v iptables >/dev/null 2>&1; then
          log_msg warn "iptables_missing skip_nfs_firewall_enforcement"
          return 0
        fi
        if [ ! -f "$NFS_ALLOWED_CIDRS_FILE" ]; then
          log_msg error "missing_allowed_cidrs_file $NFS_ALLOWED_CIDRS_FILE"
          mark_failure
          return 1
        fi

        ensure_rule() {
          proto="$1"
          port="$2"
          cidr="$3"
          if iptables -C INPUT -p "$proto" -s "$cidr" --dport "$port" -j ACCEPT >/dev/null 2>&1; then
            return 0
          fi
          reject_line="$(iptables -L INPUT --line-numbers | awk '$2 == "REJECT" {print $1; exit}')"
          if [ -n "$reject_line" ]; then
            iptables -I INPUT "$reject_line" -p "$proto" -s "$cidr" --dport "$port" -j ACCEPT
          else
            iptables -A INPUT -p "$proto" -s "$cidr" --dport "$port" -j ACCEPT
          fi
          log_msg info "inserted_firewall_rule proto=$proto port=$port cidr=$cidr"
        }

        while IFS= read -r raw_cidr; do
          cidr="$(printf '%s' "$raw_cidr" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
          [ -z "$cidr" ] && continue
          ensure_rule tcp 2049 "$cidr"
          ensure_rule udp 2049 "$cidr"
          if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" = "true" ]; then
            ensure_rule tcp "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" "$cidr"
            ensure_rule udp "$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT" "$cidr"
            ensure_rule tcp "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" "$cidr"
            ensure_rule udp "$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT" "$cidr"
          fi
        done < "$NFS_ALLOWED_CIDRS_FILE"

        if command -v iptables-save >/dev/null 2>&1; then
          install -d -m 0755 /etc/iptables
          iptables-save > /etc/iptables/rules.v4 || true
          if command -v ip6tables-save >/dev/null 2>&1; then
            ip6tables-save > /etc/iptables/rules.v6 || true
          fi
          if [ -f /lib/systemd/system/netfilter-persistent.service ] || [ -f /usr/lib/systemd/system/netfilter-persistent.service ]; then
            systemctl enable netfilter-persistent >/dev/null 2>&1 || true
          fi
        fi
      }

      enforce_log_caps() {
        root_pct="$(df --output=pcent / | tail -n1 | tr -dc '0-9')"
        log_pct="$(df --output=pcent /var/log 2>/dev/null | tail -n1 | tr -dc '0-9' || true)"

        if [ -n "$root_pct" ] && [ "$root_pct" -ge "$LOW_WATERMARK_PCT" ]; then
          log_msg warn "root_usage_high percent=$root_pct vacuuming_journal"
          journalctl --vacuum-size="$JOURNAL_VACUUM_SIZE" --vacuum-time="$JOURNAL_VACUUM_TIME" >/dev/null 2>&1 || true
        fi

        if [ -n "$log_pct" ] && [ "$log_pct" -ge "$LOW_WATERMARK_PCT" ]; then
          log_msg warn "log_usage_high percent=$log_pct vacuuming_journal_and_rotating"
          journalctl --vacuum-size="$JOURNAL_VACUUM_SIZE" --vacuum-time="$JOURNAL_VACUUM_TIME" >/dev/null 2>&1 || true
          if [ -x /usr/sbin/logrotate ]; then
            /usr/sbin/logrotate -f /etc/logrotate.conf >/dev/null 2>&1 || true
          fi
          find /var/log -type f -name '*.gz' -mtime +21 -delete >/dev/null 2>&1 || true
        fi

        if [ -n "$root_pct" ] && [ "$root_pct" -ge "$HIGH_WATERMARK_PCT" ]; then
          log_msg error "root_usage_critical percent=$root_pct"
          mark_failure
        fi
      }

      enforce_nfs_health() {
        if [ "$ENABLE_DIRECTUS_UPLOADS_NFS" != "true" ]; then
          return 0
        fi

        ensure_service_active rpcbind
        ensure_service_active nfs-kernel-server
        exportfs -ra || {
          log_msg error "exportfs_reload_failed"
          mark_failure
        }

        if ! ss -lnt | awk '{print $4}' | grep -Eq '[:.]2049$'; then
          log_msg error "nfs_port_missing tcp=2049 restarting_nfs"
          systemctl restart nfs-kernel-server || true
          sleep 1
          if ! ss -lnt | awk '{print $4}' | grep -Eq '[:.]2049$'; then
            mark_failure
          fi
        fi

        if [ "$DIRECTUS_UPLOADS_NFS_ENABLE_V3_COMPAT" = "true" ]; then
          if ! ss -lnt | awk '{print $4}' | grep -Eq "[:.]$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT$"; then
            log_msg error "rpcbind_port_missing tcp=$DIRECTUS_UPLOADS_NFS_RPCBIND_PORT"
            mark_failure
          fi
          if ! ss -lnt | awk '{print $4}' | grep -Eq "[:.]$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT$"; then
            log_msg error "mountd_port_missing tcp=$DIRECTUS_UPLOADS_NFS_MOUNTD_PORT"
            mark_failure
          fi
        fi

        if [ -n "$DIRECTUS_UPLOADS_EXPORT_PATH" ] && ! exportfs -v | grep -Fq "$DIRECTUS_UPLOADS_EXPORT_PATH"; then
          log_msg error "export_path_missing path=$DIRECTUS_UPLOADS_EXPORT_PATH"
          mark_failure
        fi
      }

      install -d -m 0755 /var/log
      touch "$GUARDIAN_LOG"
      chmod 0640 "$GUARDIAN_LOG"

      enforce_log_caps
      ensure_service_active postgresql
      if systemctl list-unit-files | awk '{print $1}' | grep -Fxq ssh.service; then
        ensure_service_active ssh
      fi
      ensure_nfs_firewall_rules
      enforce_nfs_health

      if [ "$failures" -gt 0 ]; then
        log_msg error "health_check_failed failures=$failures"
        exit 1
      fi

      log_msg info "health_check_ok"

  - path: /etc/systemd/system/directus-db-guardian.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Directus DB VM guardian
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/directus-db-guardian.sh
      Nice=10

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/directus-db-guardian.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Run Directus DB VM guardian periodically

      [Timer]
      Unit=directus-db-guardian.service
      OnBootSec=30s
      OnUnitActiveSec=90s
      RandomizedDelaySec=10s
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /etc/systemd/journald.conf.d/90-directus-db-limits.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Journal]
      Storage=persistent
      SystemMaxUse=300M
      RuntimeMaxUse=100M
      SystemMaxFileSize=50M
      MaxRetentionSec=14day
      Compress=yes

  - path: /etc/logrotate.d/directus-db-guardian
    owner: root:root
    permissions: "0644"
    content: |
      /var/log/directus-db-guardian.log {
        daily
        size 2M
        rotate 14
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
        create 0640 root root
      }

runcmd:
  - [bash, /usr/local/sbin/bootstrap-directus-postgres.sh]
  - [systemctl, daemon-reload]
  - [systemctl, restart, systemd-journald]
  - [systemctl, enable, --now, directus-db-guardian.service]
  - [systemctl, enable, --now, directus-db-guardian.timer]
